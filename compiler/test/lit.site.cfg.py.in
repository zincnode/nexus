@LIT_SITE_CFG_IN_HEADER@

# Path to the (pre-built) LLVM/MLIR tools, e.g. FileCheck, not, split-file.
# These are resolved at runtime from here via PATH in lit.cfg.py.
config.llvm_tools_dir = lit_config.substitute(path(r"@LLVM_TOOLS_DIR@"))
config.nexus_src_root = path(r"@NEXUS_SOURCE_DIR@")
config.nexus_obj_root = path(r"@NEXUS_BINARY_DIR@")
config.enable_assertions = @ENABLE_ASSERTIONS@
if "@NEXUS_ENABLE_PYTHON_BINDINGS@" == "ON":
  # Use the interpreter path literally: the `path()` helper realpaths symlinks,
  # which would break a venv python (resolving to the base interpreter and
  # dropping the venv site-packages, e.g. torch).
  config.python_executable = r"@Python3_EXECUTABLE@"
  config.nexus_python_packages_dir = path(r"@NEXUS_LIT_PYTHON_PACKAGES_DIR@")
else:
  config.python_executable = ""
  config.nexus_python_packages_dir = ""
config.torch_mlir_python_packages_dir = path(r"@TORCH_MLIR_LIT_PYTHON_PACKAGES_DIR@")

import lit.llvm
lit.llvm.initialize(lit_config, config)

# Let the main config do the real work.
lit_config.load_config(config, os.path.join(config.nexus_src_root, "test/lit.cfg.py"))
